<Project Sdk="Microsoft.NET.Sdk">

    <!-- dotskit: adds a service or a flag to a solution generated by DotNetSolutionKit, and upgrades it to a newer
         version of the template, by a three-way merge that keeps the solution's own changes. Released with the
         template, under the same tag and version: dotskit X.Y.Z knows template X.Y.Z. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>DotsKit</RootNamespace>
        <AssemblyName>dotskit</AssemblyName>

        <PackAsTool>true</PackAsTool>
        <ToolCommandName>dotskit</ToolCommandName>
        <PackageId>SawKing.DotsKit.Tool</PackageId>
        <Authors>Vladimir Savkin</Authors>
        <Description>Adds services and flags to a solution generated by DotNetSolutionKit, and upgrades it to a newer version of the template, keeping your changes.</Description>
        <PackageProjectUrl>https://dotskit.sawking.tech/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/sawking-tech/DotNetSolutionKit</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DotsKit.Tests" />
    </ItemGroup>
</Project>
