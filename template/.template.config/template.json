{
  "$schema": "http://json.schemastore.org/template",
  "author": "Vladimir Savkin",
  "classifications": ["Microservice", "Solution"],
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "identity": "Sawking.DotNetSolutionKit",
  "name": "DotNet Solution Kit",
  "description": "Microservice solution on .NET 8 and PostgreSQL. BREAKING CHANGES SINCE OCTOBER 2026: DO NOT APPLY WITH --force OVER A SOLUTION GENERATED FROM AN EARLIER VERSION, IT WILL NOT BUILD.",
  "shortName": "DotNetSolutionKit",
  "preferNameDirectory": false,

  "symbols": {
    "NamespaceRoot": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "MyCompany",
      "replaces": "NamespaceRoot",
      "fileRename": "NamespaceRoot",
      "description": "Root namespace token, usually the organization name"
    },
    "ProductName": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "Product",
      "fileRename": "ProductName",
      "replaces": "ProductName",
      "description": "Product name"
    },
    "ServiceNameOrCustom": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "Service",
      "replaces": "ServiceNameOrCustom",
      "fileRename": "ServiceNameOrCustom",
      "description": "Service name or custom (e.g. Domain.Service)"
    },
    "ServiceIdentifier": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "ServiceNameOrCustom",
        "steps": [ { "regex": "\\.", "replacement": "" } ]
      },
      "replaces": "ServiceIdentifier",
      "fileRename": "ServiceIdentifier",
      "description": "Service name without dots, for C# identifiers such as the DbContext class (Sales.Orders -> SalesOrders)"
    },
    "ServiceNameLowerDotted": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "ServiceNameOrCustom",
        "toLower": true
      }
    },
    "ServiceNameLower": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "ServiceNameLowerDotted",
        "steps": [ { "regex": "\\.", "replacement": "_" } ]
      },
      "replaces": "servicenameorcustom",
      "description": "Lower-case service name with underscores for dots (Sales.Orders -> sales_orders), for the database schema, the Infisical folder and queue names"
    },
    "Hangfire": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Background jobs on Hangfire, stored in PostgreSQL in the service's own schema, with the dashboard"
    },
    "Messaging": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "none",
      "choices": [
        { "choice": "none", "description": "No message bus" },
        { "choice": "outbox", "description": "MassTransit on RabbitMQ; messages go through a transactional outbox in the service's database" },
        { "choice": "direct", "description": "MassTransit on RabbitMQ; messages go straight to the broker and are lost if it is down" }
      ],
      "description": "Message bus for the service"
    },
    "Infisical": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Read secrets from Infisical: the shared folder and the service's folder overlay configuration"
    },
    "HttpPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port of the service in launchSettings.json; a free port from 5000-5999 when not given"
    },
    "HttpPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 5000,
        "high": 5999,
        "fallback": 5054
      }
    },
    "HttpPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "HttpPort",
        "fallbackVariableName": "HttpPortGenerated"
      },
      "replaces": "5054"
    },
    "DiffApi": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Generate the OpenAPI contract of each service without its infrastructure (--schema-only --dump-schema), and diff it on pull requests"
    },
    "FeatureFlags": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Add platform feature flags: a shared features.json, the catalogue and store, and GET/PUT /api/v1/features"
    },
    "HierarchyRules": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Add access rules over a tenant tree stored as materialized paths (IHierarchicalEntity, HierarchyRules)"
    },
    "Minimal": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "true = only microservice; false = full multi-solution kit"
    }
  },

  "sources": [
    {
      "source": ".",
      "target": ".",
      "modifiers": [
        {
          "condition": "Minimal",
          "exclude": ["**/*"]
        },
        {
          "rename": {
            ".gitignore.template": ".gitignore"
          }
        },
        {
          "condition": "(!Hangfire)",
          "exclude": [
            "**/Setup/BackgroundJobsSetup.cs",
            "**/Security/Filters/HangfireAdminAuthorizationFilter.cs"
          ]
        },
        {
          "condition": "(!Infisical)",
          "exclude": [
            "src/common/NamespaceRoot.ProductName.Common.Infrastructure/Configuration/Secrets/**",
            "src/common/NamespaceRoot.ProductName.Common.Tests/Secrets/**"
          ]
        },
        {
          "condition": "(!DiffApi)",
          "exclude": [
            "src/common/NamespaceRoot.ProductName.Common.Web/Setup/SchemaOnlyMode.cs",
            "src/common/NamespaceRoot.ProductName.Common.Web/Setup/SchemaDump.cs",
            "scripts/generate-api-schemas.sh",
            "scripts/normalise_api_schema.py",
            ".github/workflows/api-diff.yml"
          ]
        },
        {
          "condition": "(!FeatureFlags)",
          "exclude": [
            "src/common/NamespaceRoot.ProductName.Common/FeatureManagement/**",
            "src/common/NamespaceRoot.ProductName.Common.Application/FeatureManagement/**",
            "src/common/NamespaceRoot.ProductName.Common.Web/FeatureManagement/**",
            "src/common/NamespaceRoot.ProductName.Common.Tests/FeatureManagement/**"
          ]
        },
        {
          "condition": "(!HierarchyRules)",
          "exclude": [
            "src/common/NamespaceRoot.ProductName.Common/Domain/IHierarchicalEntity.cs",
            "src/common/NamespaceRoot.ProductName.Common/Domain/Policy/**",
            "src/common/NamespaceRoot.ProductName.Common.Tests/Tests/Domain/Policy/**"
          ]
        },
        {
          "exclude": [
            ".git/**",
            "**/.idea/**",
            "**/.vs/**",
            "**/[Bb]in/**",
            "**/[Oo]bj/**",
            "**/logs/**",
            "**/*.user",
            "**/*.DotSettings.user",
            ".template.config/**"
          ]
        }
      ]
    },
    {
      "source": "src/services",
      "target": "src/services",
      "modifiers": [
        {
          "condition": "(!Minimal)",
          "exclude": ["**/*"]
        },
        {
          "condition": "(!Hangfire)",
          "exclude": [
            "**/Setup/BackgroundJobsSetup.cs",
            "**/Security/Filters/HangfireAdminAuthorizationFilter.cs"
          ]
        },
        {
          "exclude": [
            "**/.idea/**",
            "**/.vs/**",
            "**/[Bb]in/**",
            "**/[Oo]bj/**",
            "**/logs/**",
            "**/*.user",
            "**/*.DotSettings.user",
            "manual-add-projects.sh",
            "NamespaceRoot.ProductName.All.sln"
          ]
        }
      ]
    }
  ],

  "postActions": [
    {
      "condition": "true",
      "actionId": "00000000-0000-0000-0000-000000000001",
      "continueOnError": true,
      "description": "After generating services, verify and add projects to All.sln",
      "manualInstructions": [
        { "text": "1. Navigate to services folder: cd ./src/services\n2. Run script: ./manual-add-projects.sh\n3. The script will check all service projects and add them to All.sln, skipping already added ones." }
      ]
    }
  ]
}
